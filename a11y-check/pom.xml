<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example.a11y</groupId>
  <artifactId>a11y-check</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>PDF accessibility checker (veraPDF + PDFBox) - vendor-neutral</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>com.example.a11y.A11yCheck</exec.mainClass>
  </properties>

  <dependencies>
    <!-- veraPDF: open-source PDF/UA + PDF/A validator (Matterhorn-based rules). MPL 2.0 / GPL 3 -->
    <dependency>
      <groupId>org.verapdf</groupId>
      <artifactId>validation-model</artifactId>
      <version>1.30.4</version>
    </dependency>
    <!-- PDFBox: used to read the tag tree directly -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
