{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spanish loan summary payload",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "agreement": {
      "type": "object",
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date yyyy-MM-dd"
        }
      },
      "required": [
        "number",
        "date"
      ]
    },
    "lender": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    },
    "borrower": {
      "type": "object",
      "properties": {
        "legalName": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "legalName",
        "address"
      ]
    },
    "facilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "typeEs": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maturityDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date yyyy-MM-dd"
          }
        },
        "required": [
          "id",
          "typeEs",
          "currency",
          "amount",
          "maturityDate"
        ]
      }
    },
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "roleEs": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "roleEs"
        ]
      }
    }
  },
  "required": [
    "agreement",
    "lender",
    "borrower",
    "facilities",
    "signers"
  ]
}