{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Term loan agreement payload",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "agreement": {
      "type": "object",
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date yyyy-MM-dd"
        }
      },
      "required": [
        "number",
        "date"
      ]
    },
    "lender": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    },
    "borrower": {
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "minLength": 1
        },
        "legalName": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "customerId",
        "legalName",
        "address"
      ]
    },
    "facilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "maturityDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date yyyy-MM-dd"
          }
        },
        "required": [
          "id",
          "type",
          "currency",
          "amount",
          "maturityDate"
        ]
      }
    },
    "collateral": {
      "type": "array",
      "description": "Use [] for an unsecured loan",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code"
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ltvLimitPct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "description",
          "currency",
          "value"
        ]
      }
    },
    "covenants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "threshold": {
            "type": "string",
            "minLength": 1
          },
          "frequency": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "threshold",
          "frequency"
        ]
      }
    },
    "signers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]{1,30}$",
            "description": "Used as a Word bookmark name: letters, digits, underscore"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "role"
        ]
      }
    },
    "signatureRequired": {
      "type": "boolean"
    }
  },
  "required": [
    "agreement",
    "lender",
    "borrower",
    "facilities"
  ],
  "if": {
    "properties": {
      "signatureRequired": {
        "const": true
      }
    },
    "required": [
      "signatureRequired"
    ]
  },
  "then": {
    "required": [
      "signers"
    ],
    "properties": {
      "signers": {
        "minItems": 1
      }
    }
  }
}